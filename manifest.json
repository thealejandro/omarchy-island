{
  "schemaVersion": 1,
  "id": "thealejandro.island",
  "name": "Island",
  "version": "0.9.0",
  "author": "thealejandro",
  "description": "A dynamic island for the Omarchy bar, on any edge and hanging from the clock: now playing with media controls, a calendar with a local agenda and reminders, world time and a 3-day forecast, a pomodoro focus timer, quick actions and Omarchy quick toggles, with a visual settings page. Can take over Omarchy volume and brightness OSD and, when you turn it on, its notifications (with a list and history); peeks on track changes, events, charging and low battery, shows when AI coding agents (Claude Code, Codex…) need you or finish, and follows your theme live.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Island",
    "description": "Lets the island hang from the clock and hides Omarchy inactive indicators while the island carries them",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "defaultPage": "home",
      "calendarFirst": false,
      "showMedia": true,
      "lyrics": false,
      "lyricsPeek": false,
      "showTimer": true,
      "showDock": true,
      "openWidth": 560,
      "blur": true,
      "clock": true,
      "clockClick": "calendar",
      "anchor": "clock",
      "clockWidth": 120,
      "hoverOpen": true,
      "keyboard": true,
      "hoverDelay": 120,
      "peekDuration": 3500,
      "toggles": "island",
      "barClicks": true,
      "widgetIcon": false,
      "units": "metric",
      "forecast": true,
      "reminderLead": 10,
      "icsSources": "",
      "icsRefresh": 15,
      "agendaCommand": "",
      "osd": false,
      "battery": true,
      "privacyDots": true,
      "privacyPeek": true,
      "agents": true,
      "agentPeek": true,
      "agentPeekDuration": 5000,
      "agentDot": true,
      "agentStale": 120,
      "animations": true,
      "notifications": "off",
      "notifyBody": true,
      "notifyPeekDuration": 6000,
      "notifyHistory": true,
      "notifyHistoryLimit": 100,
      "notifyBadge": true,
      "notifyKeyboardIdle": 10000
    },
    "schema": [
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "options": [
          "en",
          "es"
        ]
      },
      {
        "key": "defaultPage",
        "type": "enum",
        "label": "Opens on",
        "options": [
          "home",
          "calendar",
          "world"
        ],
        "defaultValue": "home"
      },
      {
        "key": "calendarFirst",
        "type": "boolean",
        "label": "Agenda first on Home",
        "defaultValue": false
      },
      {
        "key": "showMedia",
        "type": "boolean",
        "label": "Now playing",
        "defaultValue": true
      },
      {
        "key": "lyrics",
        "type": "boolean",
        "label": "Synced lyrics",
        "defaultValue": false
      },
      {
        "key": "lyricsPeek",
        "type": "boolean",
        "label": "Lyrics glance while a song plays",
        "defaultValue": false
      },
      {
        "key": "showTimer",
        "type": "boolean",
        "label": "Focus timer",
        "defaultValue": true
      },
      {
        "key": "showDock",
        "type": "boolean",
        "label": "Toggles and launchers",
        "defaultValue": true
      },
      {
        "key": "openWidth",
        "type": "integer",
        "label": "Width",
        "min": 420,
        "max": 800,
        "step": 20,
        "defaultValue": 560
      },
      {
        "key": "blur",
        "type": "boolean",
        "label": "Blur behind a glassy bar",
        "defaultValue": true
      },
      {
        "key": "clock",
        "type": "boolean",
        "label": "Open by hovering the clock",
        "defaultValue": true
      },
      {
        "key": "clockClick",
        "type": "enum",
        "label": "Clicking the clock",
        "options": [
          "pin",
          "calendar",
          "omarchy"
        ],
        "defaultValue": "calendar"
      },
      {
        "key": "anchor",
        "type": "enum",
        "label": "Hang from",
        "options": [
          "clock",
          "widget",
          "center"
        ],
        "defaultValue": "clock"
      },
      {
        "key": "clockWidth",
        "type": "integer",
        "label": "Clock zone when not found",
        "min": 60,
        "max": 400,
        "step": 10,
        "defaultValue": 120
      },
      {
        "key": "hoverOpen",
        "type": "boolean",
        "label": "Open on hover",
        "defaultValue": true
      },
      {
        "key": "keyboard",
        "type": "boolean",
        "label": "Keyboard navigation",
        "defaultValue": true
      },
      {
        "key": "hoverDelay",
        "type": "integer",
        "label": "Hover delay",
        "min": 0,
        "max": 600,
        "step": 20,
        "defaultValue": 120
      },
      {
        "key": "peekDuration",
        "type": "integer",
        "label": "Glance duration",
        "min": 1000,
        "max": 10000,
        "step": 500,
        "defaultValue": 3500
      },
      {
        "key": "animations",
        "type": "boolean",
        "label": "Animations",
        "defaultValue": true
      },
      {
        "key": "toggles",
        "type": "enum",
        "label": "Quick toggles",
        "options": [
          "island",
          "both",
          "bar"
        ],
        "defaultValue": "island"
      },
      {
        "key": "barClicks",
        "type": "boolean",
        "label": "Clock, world clock and weather open the island",
        "defaultValue": true
      },
      {
        "key": "widgetIcon",
        "type": "boolean",
        "label": "Island button on the bar",
        "defaultValue": false
      },
      {
        "key": "units",
        "type": "enum",
        "label": "Units",
        "options": [
          "metric",
          "imperial"
        ],
        "defaultValue": "metric"
      },
      {
        "key": "forecast",
        "type": "boolean",
        "label": "3-day forecast",
        "defaultValue": true
      },
      {
        "key": "hour24",
        "type": "boolean",
        "label": "Clock format"
      },
      {
        "key": "cities",
        "type": "string",
        "label": "Cities (Name|Zone, …)"
      },
      {
        "key": "weekStart",
        "type": "integer",
        "label": "Week starts on",
        "min": 1,
        "max": 7
      },
      {
        "key": "reminderLead",
        "type": "integer",
        "label": "Remind me before",
        "min": 0,
        "max": 120,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "icsSources",
        "type": "string",
        "label": "Calendars (.ics folders, files or links)",
        "defaultValue": ""
      },
      {
        "key": "icsRefresh",
        "type": "integer",
        "label": "Refresh calendars every",
        "min": 5,
        "max": 240,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "agendaCommand",
        "type": "string",
        "label": "External agenda command",
        "defaultValue": ""
      },
      {
        "key": "osd",
        "type": "boolean",
        "label": "Show Omarchy's OSD here",
        "defaultValue": false
      },
      {
        "key": "battery",
        "type": "boolean",
        "label": "Battery glances",
        "defaultValue": true
      },
      {
        "key": "privacyDots",
        "type": "boolean",
        "label": "Microphone and camera dots",
        "defaultValue": true
      },
      {
        "key": "privacyPeek",
        "type": "boolean",
        "label": "Glance when an app starts using them",
        "defaultValue": true
      },
      {
        "key": "agents",
        "type": "boolean",
        "label": "AI agent status",
        "defaultValue": true
      },
      {
        "key": "agentPeek",
        "type": "boolean",
        "label": "Glance when an agent needs you or finishes",
        "defaultValue": true
      },
      {
        "key": "agentPeekDuration",
        "type": "integer",
        "label": "Agent glance duration",
        "min": 2000,
        "max": 15000,
        "step": 500,
        "defaultValue": 5000
      },
      {
        "key": "agentDot",
        "type": "boolean",
        "label": "Dot when an agent needs you",
        "defaultValue": true
      },
      {
        "key": "agentStale",
        "type": "integer",
        "label": "Forget a stuck agent after",
        "min": 10,
        "max": 480,
        "step": 10,
        "defaultValue": 120
      },
      {
        "key": "notifications",
        "type": "enum",
        "label": "Notifications",
        "options": [
          "off",
          "island"
        ],
        "defaultValue": "off"
      },
      {
        "key": "notifyBody",
        "type": "boolean",
        "label": "Notification text in the glance",
        "defaultValue": true
      },
      {
        "key": "notifyPeekDuration",
        "type": "integer",
        "label": "Notification glance duration",
        "min": 2000,
        "max": 15000,
        "step": 500,
        "defaultValue": 6000
      },
      {
        "key": "notifyHistory",
        "type": "boolean",
        "label": "Keep notification history",
        "defaultValue": true
      },
      {
        "key": "notifyHistoryLimit",
        "type": "integer",
        "label": "History size",
        "min": 20,
        "max": 500,
        "step": 20,
        "defaultValue": 100
      },
      {
        "key": "notifyBadge",
        "type": "boolean",
        "label": "Unread dot",
        "defaultValue": true
      },
      {
        "key": "notifyKeyboardIdle",
        "type": "integer",
        "label": "Keyboard mode timeout",
        "min": 3000,
        "max": 30000,
        "step": 1000,
        "defaultValue": 10000
      }
    ]
  }
}
